[
  {
    "id": "global",
    "title": "Conditioning looks beyond the next edge",
    "why": "Original start choices are equal, but risky succeeds only 1/4 of the time. Conditional on eventual success, risky gets 1/5, direct goal 4/5. Mean time to any terminal is 3/2; mean given success is 6/5; unconditional stopped-success time is infinite.",
    "input": {
      "states": [
        {
          "name": "start",
          "transitions": [
            {
              "to": "goal",
              "prob": "1/2"
            },
            {
              "to": "risky",
              "prob": "1/2"
            }
          ]
        },
        {
          "name": "risky",
          "transitions": [
            {
              "to": "goal",
              "prob": "1/4"
            },
            {
              "to": "fail",
              "prob": "3/4"
            }
          ]
        },
        {
          "name": "goal",
          "transitions": [
            {
              "to": "goal",
              "prob": "1"
            }
          ]
        },
        {
          "name": "fail",
          "transitions": [
            {
              "to": "fail",
              "prob": "1"
            }
          ]
        }
      ],
      "success": [
        "goal"
      ],
      "failure": [
        "fail"
      ],
      "horizon": 8
    }
  },
